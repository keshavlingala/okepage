{
  "name": "okepage",
  "compatibility_date": "2026-08-19",

  // No build step and no Worker script — Okepage is plain HTML/CSS/JS served
  // straight from the repo root. Files that are not part of the app are listed
  // in .assetsignore so they never get uploaded.
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },

  // Keep the workers.dev URL alive alongside the custom domain. Declaring
  // "routes" turns this off by default, which would retire the URL silently.
  "workers_dev": true,

  // Custom domain. Cloudflare creates and manages the DNS record for this
  // hostname; the apex and www records that point keshav.codes at GitHub Pages
  // are left alone.
  "routes": [
    { "pattern": "okepage.keshav.codes", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
